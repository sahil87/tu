dist/
bin/

# Transient help-dump artifact — `tu help-dump` emits the contract JSON; shll.ai
# pulls it via its own cron (shll.ai is the source of truth). `tu help-dump >
# help/tu.json` writes this locally for inspection; never committed here.
# Root-anchored: an unanchored `help/` would also swallow harness/golden/run/help/.
/help/

.fab-status.yaml

.fab-*


.status.yaml.lock

!fab/.fab-version

.uploads/

/.claude/settings.local.json

# Real ccusage captures (harness/fixtures/<machine>/) carry the capturing user's
# spend data and stay local. Only the schema-derived placeholder corpus is
# committed. See docs/memory/harness/differential-harness.md.
harness/fixtures/*/
!harness/fixtures/_placeholder/
